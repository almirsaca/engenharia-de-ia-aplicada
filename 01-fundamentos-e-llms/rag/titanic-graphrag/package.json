{
  "name": "titanic-graphrag",
  "version": "0.0.1",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --no-warnings --env-file .env --experimental-strip-types src/index.ts",
    "dev": "node --no-warnings --env-file .env --watch --experimental-strip-types src/index.ts",
    "load": "node --no-warnings --env-file .env --experimental-strip-types src/loadGraph.ts",
    "debug": "node --no-warnings --inspect-brk=9229 --env-file .env --experimental-strip-types src/index.ts",
    "log": "node --no-warnings --experimental-strip-types src/verLog.ts",
    "infra:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f ../docker-compose.yml down"
  },
  "keywords": [],
  "license": "MIT",
  "description": "RAG híbrido sobre o Titanic: busca vetorial nos PDFs e agregação Cypher no grafo de passageiros",
  "engines": {
    "node": ">=22.13.1"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.4.2",
    "neo4j-driver": "^5.28.0"
  }
}
