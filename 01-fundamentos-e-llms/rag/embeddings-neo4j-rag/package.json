{
  "name": "embeddings-neo4j-rag",
  "version": "0.0.1",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --no-warnings --env-file .env --experimental-strip-types src/index.ts",
    "dev": "node --no-warnings --env-file .env --watch --experimental-strip-types src/index.ts",
    "debug": "node --no-warnings --inspect-brk=9229 --env-file .env --experimental-strip-types src/index.ts",
    "infra:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f ../docker-compose.yml down"
  },
