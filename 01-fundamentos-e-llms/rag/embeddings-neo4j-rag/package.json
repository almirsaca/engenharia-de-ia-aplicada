  "license": "MIT",
  "description": "",
  "engines": {
    "node": "v22.13.1"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/inference": "^4.13.5",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.4.2",
    "@langchain/textsplitters": "^0.1.0",
    "@xenova/transformers": "^2.17.2",
    "neo4j-driver": "^5.28.0",
    "pdf-parse": "^1.1.1"
  }
